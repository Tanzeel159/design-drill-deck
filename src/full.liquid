<!-- Native Framework brief: essential instructions are rendered on the device. -->
<div class="layout layout--col flex--stretch-x flex--top gap--small lg:gap--large p--4 text--black text--left">
{% if feed_empty or p == blank %}
  <p class="description lg:description--large text--bold m--0 w--full">Design Drill Deck</p>
  <h1 class="title title--xlarge lg:title--xxlarge portrait:title--xlarge text--bold m--0 w--full">No prompts loaded.</h1>
  <p class="description description--large lg:description--xlarge m--0 w--full">The daily deck is empty or did not arrive. It will retry on the next refresh.</p>
{% else %}
  <p class="description lg:description--large text--bold m--0 w--full">{{ card_mode | escape }} · {{ level_profile.label | default: difficulty | capitalize | escape }}</p>
  <div class="flex flex--row flex--left flex--center-y gap--large lg:gap--xlarge w--full portrait:flex--col">{% if stripped_art != blank %}<div class="w--20 lg:w--48 portrait:w--32 flex-none">{{ card_art }}</div>{% endif %}<div class="flex flex--col flex--stretch-x gap--small lg:gap--medium flex-auto w--min-0"><h1 class="title title--xlarge lg:title--xxlarge portrait:title--xlarge text--bold m--0 w--full">{{ card_title | escape }}</h1><p class="description description--xlarge lg:description--xxlarge m--0 w--full">{{ card_brief | escape }}</p></div></div>
  <div class="divider w--full"></div>
  <div class="flex flex--row flex--left flex--top gap--medium lg:gap--large w--full portrait:flex--col"><div class="flex flex--col flex--stretch-x w--1/3 portrait:w--full w--min-0"><div class="flex flex--col flex--stretch-x gap--xsmall w--full w--min-0"><div class="flex flex--row flex--left flex--center-y gap--small w--full"><svg class="flex-none" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="black" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="7" r="4"/><path d="M4 22v-3a8 8 0 0 1 16 0v3"/></svg><h2 class="title title--small lg:title--base text--bold m--0">Who it is for</h2></div><p class="description description--large lg:description--xlarge m--0 w--full" data-clamp="2">{{ p.primary_user | escape }}</p></div></div><div class="divider divider--v portrait:hidden"></div><div class="flex flex--col flex--stretch-x w--1/3 portrait:w--full w--min-0"><div class="flex flex--col flex--stretch-x gap--xsmall w--full w--min-0"><div class="flex flex--row flex--left flex--center-y gap--small w--full"><svg class="flex-none" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="black" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="9"/><circle cx="12" cy="12" r="5"/><circle cx="12" cy="12" r="1"/></svg><h2 class="title title--small lg:title--base text--bold m--0">Goal</h2></div><p class="description description--large lg:description--xlarge m--0 w--full" data-clamp="2">{{ p.business_goal | escape }}</p></div></div><div class="divider divider--v portrait:hidden"></div><div class="flex flex--col flex--stretch-x w--1/3 portrait:w--full w--min-0"><div class="flex flex--col flex--stretch-x gap--xsmall w--full w--min-0"><div class="flex flex--row flex--left flex--center-y gap--small w--full"><svg class="flex-none" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="black" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="5" y="10" width="14" height="12" rx="2"/><path d="M8 10V6a4 4 0 0 1 8 0v4"/></svg><h2 class="title title--small lg:title--base text--bold m--0">Constraint</h2></div><p class="description description--large lg:description--xlarge m--0 w--full" data-clamp="2">{{ p.constraint | escape }}</p></div></div></div>
  <div class="divider w--full"></div>
  <div class="flex flex--row flex--left flex--top gap--large w--full portrait:flex--col">
    <div class="w--1/2 portrait:w--full w--min-0"><div class="flex flex--col flex--stretch-x gap--xsmall w--full w--min-0"><div class="flex flex--row flex--left flex--center-y gap--small w--full"><h2 class="title title--small lg:title--base text--bold m--0">Your task</h2></div><p class="description description--large lg:description--xlarge m--0 w--full" data-clamp="2">{{ card_scope_short | escape }}</p></div></div><div class="w--1/2 portrait:w--full w--min-0"><div class="flex flex--col flex--stretch-x gap--xsmall w--full w--min-0"><div class="flex flex--row flex--left flex--center-y gap--small w--full"><h2 class="title title--small lg:title--base text--bold m--0">Work through</h2></div><p class="description description--large lg:description--xlarge m--0 w--full" data-clamp="2">{{ card_patterns | escape }}</p></div></div>
  </div>
  <div class="divider w--full"></div>
  <p class="description description--large lg:description--xlarge m--0 w--full" data-clamp="2"><strong>Watch for:</strong> {{ p.watch_for | escape }}</p>
  <div class="hidden lg:visible lg:portrait:hidden"><p class="description description--large lg:description--xlarge m--0 w--full" data-clamp="2"><strong>Discuss:</strong> {{ p.interview_focus | escape }}</p></div>
{% endif %}
</div>
{% assign title_instance = display_date | date: '%b %-d' %}<div class="title_bar"><span class="title">Design Drill Deck</span>{% if title_instance != blank %}<span class="instance">{{ title_instance }}</span>{% endif %}</div>
