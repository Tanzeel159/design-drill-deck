<!-- Shared markup supplies selection and styles, including lg: and portrait: adaptations. -->
<article class="ddd-card ddd-hh ddd-{{ card_style }}" data-card-id="{{ p.id | escape }}">
{% if p == blank %}
  <p class="ddd-kicker">Design Drill Deck</p>
  <div class="ddd-main"><div class="ddd-copy"><h1 class="ddd-title">No drill available.</h1></div></div>
{% else %}
  <p class="ddd-kicker">{{ p.mode | escape }} · {{ level_profile.label | default: difficulty | capitalize | escape }}</p>
  <div class="ddd-main">
    <div class="ddd-copy"><h1 class="ddd-title">{{ card_title | escape }}</h1><p class="ddd-brief">{{ card_compact | escape }}</p></div>

  </div>
{% endif %}
  <footer class="ddd-footer"><span>Design Drill Deck</span><span>{{ display_date | date: "%b %-d" }}</span></footer>
</article>
