<!-- Native Framework sizing and lg: / portrait: composition; ddd-* hooks are for inspection only. -->
<article class="ddd-card ddd-hh ddd-{{ card_style }} layout flex flex--col flex--stretch-x gap p--4 text--black text--left" data-card-id="{{ p.id | escape }}">
{% if p == blank %}
  <p class="ddd-kicker label label--large text--bold m--0 flex-none w--full">Design Drill Deck</p>
  <div class="ddd-main flex flex--row flex--left flex--center-y gap--large flex-auto h--min-0 w--full"><div class="ddd-copy flex flex--col flex--stretch-x flex--center-y gap flex-auto w--min-0"><h1 class="ddd-title title title--large text--bold m--0 w--full">No drill available.</h1></div></div>
{% else %}
  <p class="ddd-kicker label label--large text--bold m--0 flex-none w--full">{{ level_profile.label | default: difficulty | capitalize | escape }}</p>
  <div class="ddd-main flex flex--row flex--left flex--center-y gap--large flex-auto h--min-0 w--full">
    <div class="ddd-copy flex flex--col flex--stretch-x flex--center-y gap flex-auto w--min-0"><h1 class="ddd-title title title--large text--bold m--0 w--full">{{ card_title | escape }}</h1><p class="ddd-brief description description--xlarge m--0 w--full">{{ card_compact | escape }}</p></div>

  </div>
{% endif %}
</article>
<div class="title_bar ddd-footer">
  <span class="title">Design Drill Deck</span><span class="instance">{{ display_date | date: "%b %-d" }}</span>
</div>
