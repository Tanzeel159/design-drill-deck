{% assign prompt_total = prompts | size %}
{% assign settings_values = trmnl.plugin_settings.custom_fields_values %}
{% assign focus_area = settings_values.focus_area | default: "all" %}
{% assign difficulty = settings_values.difficulty | default: default_difficulty | default: "intermediate" %}
{% assign rotation_mode = settings_values.rotation_mode | default: default_rotation_mode | default: "smart_shuffle" %}
{% assign level_matches = difficulty_levels | where: "key", difficulty %}
{% assign level_profile = level_matches | first %}
{% assign pattern_limit = level_profile.pattern_limit | default: 4 %}
{% assign picks_for_mode = daily_picks[rotation_mode] %}
{% assign picks_for_focus = picks_for_mode[focus_area] %}
{% assign pick = picks_for_focus[difficulty] %}
{% if pick == blank and picks_for_focus.prompt_id != blank %}
  {% assign pick = picks_for_focus %}
{% endif %}
{% if pick == blank %}
  {% assign pick = daily_picks.smart_shuffle.all.intermediate | default: daily_picks.smart_shuffle.all %}
{% endif %}
{% if pick != blank %}
  {% assign matches = prompts | where: "id", pick.prompt_id %}
  {% assign p = matches | first %}
  {% assign drill_number = pick.drill_number | default: pick.position %}
  {% assign total = pick.pool_size %}
{% else %}
  {% assign day = "now" | date: "%j" | plus: 0 %}
  {% assign legacy_idx = day | modulo: prompt_total %}
  {% assign p = prompts[legacy_idx] %}
  {% assign drill_number = legacy_idx | plus: 1 %}
  {% assign total = prompt_total %}
{% endif %}
{% if p == blank %}
  {% assign p = prompts | first %}
{% endif %}
{% assign display_date = display_date | default: rotation_date | default: "now" %}

