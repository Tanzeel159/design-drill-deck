<!-- Native Framework brief: essential instructions are rendered on the device. -->
<div class="layout layout--col flex--stretch-x flex--top gap--small lg:gap--medium p--4 text--black text--left">
{% if feed_empty or p == blank %}
  <p class="description lg:description--large text--bold m--0 w--full">Design Drill Deck</p>
  <h1 class="title title--large lg:title--xlarge portrait:title--large text--bold m--0 w--full">No prompts loaded.</h1>
  <p class="description description--large lg:description--xlarge m--0 w--full">The daily deck is empty or did not arrive. It will retry on the next refresh.</p>
{% else %}
  <p class="description lg:description--large text--bold m--0 w--full">{{ level_profile.label | default: difficulty | capitalize | escape }} practice</p>
  <h1 class="title title--large lg:title--xlarge portrait:title--large text--bold m--0 w--full">{{ card_title | escape }}</h1><p class="description description--large lg:description--xlarge m--0 w--full">{{ card_compact | escape }}</p><div class="hidden lg:flex flex--col flex--stretch-x gap--medium w--full"><div class="flex flex--row flex--left flex--top m--0 w--full"><span class="text text--base lg:text--large text--bold flex-none">Constraint:</span><span class="description description--large lg:description--xlarge flex-auto w--min-0" data-clamp="1" data-clamp-lg-portrait="2">{{ p.constraint | escape }}</span></div><div class="flex flex--row flex--left flex--top m--0 w--full"><span class="text text--base lg:text--large text--bold flex-none">Who:</span><span class="description description--large lg:description--xlarge flex-auto w--min-0" data-clamp="1" data-clamp-lg-portrait="2">{{ p.primary_user | escape }}</span></div><div class="flex flex--row flex--left flex--top m--0 w--full"><span class="text text--base lg:text--large text--bold flex-none">Produce:</span><span class="description description--large lg:description--xlarge flex-auto w--min-0" data-clamp="1" data-clamp-lg-portrait="2">{{ card_scope_short | escape }}</span></div></div>
{% endif %}
</div>
<div class="title_bar"><span class="title">Design Drill Deck</span></div>
