<!-- Shared markup supplies selection and styles, including lg: and portrait: adaptations. -->
<article class="ddd-card ddd-q ddd-{{ card_style }}" data-card-id="{{ p.id | escape }}">
{% if p == blank %}
  <p class="ddd-kicker">Design Drill Deck</p>
  <div class="ddd-main"><div class="ddd-copy"><h1 class="ddd-title">No drill available.</h1></div></div>
{% else %}
  <p class="ddd-kicker">{{ level_profile.label | default: difficulty | capitalize | escape }}</p>
  <div class="ddd-main">
    <div class="ddd-copy"><h1 class="ddd-title">{{ card_compact | escape }}</h1></div>

  </div>
{% endif %}
  <footer class="ddd-footer"><span>Design Drill Deck</span></footer>
</article>
